# ASMA Lines environment configuration
PORT=3000

# Telegram Bot Integration (Option 2 - instant notifications for site leads)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram Direct Contact Username (Option 2 - for direct 1-click messaging)
TELEGRAM_USERNAME=asmalines_bot

# PlanFix CRM Integration
# Email for automatic Task Creation in PlanFix
PLANFIX_EMAIL=Plomba@asma.planfix.com
# Webhook URL (Управление аккаунтом -> Интеграции -> Входящие вебхуки)
PLANFIX_WEBHOOK_URL=
# Embedded Web Form URL (Управление аккаунтом -> Веб-формы)
PLANFIX_FORM_URL=

# SMTP Server configuration for sending email tasks to PlanFix
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
