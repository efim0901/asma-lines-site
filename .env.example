# ASMA Lines environment & secrets configuration
PORT=3000

# Telegram Bot Integration (Cloudflare Secret)
# Токен бота Telegram от @BotFather (напр. 8808722578:AAEYNIMN8P7LG8IYtUOsytw6yWO1bEBLlLI)
TELEGRAM_BOT_TOKEN=

# ID чата или группы для получения заявок с сайта (напр. -5230752915 или 1014012851)
TELEGRAM_CHAT_ID=-5230752915

# Telegram Username бота (без знака @, напр. asmalinesbot)
TELEGRAM_USERNAME=asmalinesbot

# Главный администратор системы (Telegram username и ID)
MASTER_ADMIN_USERNAME=plombit
MASTER_ADMIN_ID=1014012851

# Базовый URL CRM (по умолчанию формируется автоматически из домена)
CRM_APP_URL=https://asma-lines-site.firws.workers.dev/crm.html

# PlanFix CRM Integration (Email для автоматического создания задач в ПланФикс)
PLANFIX_EMAIL=Plomba@asma.planfix.com
PLANFIX_WEBHOOK_URL=
PLANFIX_FORM_URL=

# SMTP Server configuration (опционально)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

