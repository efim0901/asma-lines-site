.git
node_modules
.wrangler
.dev.vars
.env
.env.local

# Персональные данные клиентов: заявки, телефоны, список доступа.
# НИКОГДА не коммитим — в репозитории уже были реальные номера клиентов.
data/
!data/.gitkeep

# Локальные бэкапы/повреждённые копии состояния
*.corrupt-*.bak
.tmp-*

# Снимки страниц для проверки вёрстки и тем (см. _tools/shoot-site.mjs).
# В репозитории не нужны: это рабочий материал, а не часть сайта.
_shots/

# Скриншоты макетов диспетчерской: 1,8 МБ, к работе сайта не относятся
# и пересобираются командой (см. _prototypes/README.md).
#   node _tools/shoot-prototype.mjs
#   node _tools/shoot-crm.mjs
_prototypes/*.png
