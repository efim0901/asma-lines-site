# Заголовки для Cloudflare.
# Полный список директив: https://developers.cloudflare.com/pages/configuration/headers/
#
# ВАЖНО: этот файл НЕ единственный источник заголовков.
# По документации Cloudflare правила из `_headers` не применяются к ответам,
# которые формирует код Worker:
#   https://developers.cloudflare.com/workers/static-assets/headers/
# А `_worker.js` перехватывает все не-API пути и сам вызывает env.ASSETS.fetch(),
# поэтому те же заголовки выставлены в `_worker.js` в функции withStaticHeaders().
# Правило для /crm.html здесь не срабатывало — отсюда и дублирование.
#
# Правите заголовки — правьте оба места и сверяйте ответ реального запроса.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Строгий CSP без 'unsafe-inline' для скриптов: весь исполняемый JS вынесен
  # в отдельные файлы (assets/*.js), inline-обработчиков onclick в разметке нет.
  # JSON-LD блоки остаются инлайновыми — это application/ld+json, он не исполняется.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://nominatim.openstreetmap.org https://router.project-osrm.org https://*.tile.openstreetmap.org; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

  # Cache-Control для HTML/служебных файлов: всегда перепроверяем,
  # чтобы правки разметки не залипали из-за immutable-кэша.
  Cache-Control: public, max-age=0, must-revalidate

# Страницы CRM и документов: запрет индексации.
# Для crm.html разрешаем встраивание в Telegram Web (web.telegram.org).
/crm.html
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'; upgrade-insecure-requests
  Cache-Control: no-store

/order-doc.html
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Cache-Control: no-store

/proposal.html
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Cache-Control: no-store

/api/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Логотипы и иконки
/assets/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Остальные ассеты. ВАЖНО: из-за immutable путь к файлу обязан меняться
# при правке — используйте ?v=ГГГГММДД в разметке.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
